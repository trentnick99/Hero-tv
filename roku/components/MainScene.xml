<?xml version="1.0" encoding="utf-8" ?>
<!-- The whole app: full-screen live TV, a channel banner, the TV guide, the channel list, the on-demand library
     (Left), the Weather channel, reminders and "up next". -->
<component name="MainScene" extends="Scene">
  <interface>
    <field id="exitApp" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="MainScene.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0b0e17FF" />
    <Video id="video" width="1920" height="1080" translation="[0,0]" enableUI="false" />

    <Group id="wx" visible="false">
      <Rectangle width="1920" height="1080" color="0x0d2340FF" />
      <Rectangle width="1920" height="380" translation="[0,700]" color="0x0a1a30FF" />
      <Label id="wxHead" translation="[120,70]" width="1100" font="font:MediumBoldSystemFont" color="0x2fa4ffFF" text="WEATHER" />
      <Label id="wxPlace" translation="[120,115]" width="1100" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="wxTemp" translation="[110,190]" width="560" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="190" />
      </Label>
      <Label id="wxCond" translation="[700,230]" width="1100" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="wxDetail" translation="[700,310]" width="1100" wrap="true" maxLines="3" font="font:MediumSystemFont" color="0xC8CDD8FF" />
      <Label id="wxAlert" translation="[120,450]" width="1680" wrap="true" maxLines="4" font="font:MediumBoldSystemFont" color="0xFF6B6BFF" />
      <Label translation="[120,600]" width="800" font="font:SmallBoldSystemFont" color="0x9AA3B5FF" text="NEXT HOURS" />
      <Group id="wxHours" translation="[120,640]" />
      <Label translation="[120,830]" width="800" font="font:SmallBoldSystemFont" color="0x9AA3B5FF" text="THE WEEK" />
      <Group id="wxDays" translation="[120,870]" />
    </Group>

    <Group id="card" visible="false">
      <Rectangle width="1920" height="1080" color="0x0d1322FF" />
      <Poster id="cdPic" translation="[110,259]" width="1000" height="562" loadDisplayMode="scaleToFill" />
      <Rectangle id="cdBar" translation="[1170,300]" width="10" height="70" color="0xffcf1fFF" />
      <Label id="cdHead" translation="[1200,300]" width="640" font="font:SmallBoldSystemFont" color="0xffcf1fFF" />
      <Label id="cdTitle" translation="[1200,345]" width="640" wrap="true" maxLines="3" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="cdAt" translation="[1200,560]" width="640" font="font:MediumSystemFont" color="0xC8CDD8FF" />
      <Label id="cdPlot" translation="[1200,620]" width="640" wrap="true" maxLines="4" font="font:SmallestSystemFont" color="0x9AA3B5FF" />
      <Label id="cdLeft" translation="[1200,790]" width="640" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
    </Group>

    <Group id="bug" visible="false" opacity="0.8" translation="[1400,50]">
      <Rectangle width="460" height="60" color="0x00000073" />
      <Rectangle id="bugPlate" translation="[8,8]" width="84" height="44" color="0xffcf1fFF" />
      <Label id="bugNum" translation="[8,8]" width="84" height="44" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" color="0x0b0d16FF" />
      <Label id="bugName" translation="[106,8]" width="340" height="44" vertAlign="center" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
    </Group>

    <Group id="banner" visible="false" translation="[0,780]">
      <Rectangle width="1920" height="300" color="0x000000C8" />
      <Rectangle id="bnBar" width="12" height="220" translation="[90,40]" color="0xffcf1fFF" />
      <Label id="bnNum" translation="[130,36]" width="200" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="bnChan" translation="[330,48]" width="1200" font="font:MediumSystemFont" color="0xC8CDD8FF" />
      <Label id="bnTitle" translation="[130,110]" width="1500" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="bnTime" translation="[130,175]" width="1500" font="font:SmallSystemFont" color="0xC8CDD8FF" />
      <Label id="bnNext" translation="[130,215]" width="1500" font="font:SmallSystemFont" color="0x9AA3B5FF" />
      <Label id="bnHelp" translation="[1030,48]" width="800" horizAlign="right" font="font:SmallestSystemFont" color="0x9AA3B5FF"
             text="OK guide    Left: on demand    Replay: last channel    Rew: start over    *: subtitles" />
    </Group>

    <Group id="guide" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0e17EE" />
      <Label id="gStation" translation="[100,60]" width="900" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="gHint" translation="[100,125]" width="900" font="font:SmallestSystemFont" color="0x9AA3B5FF"
             text="Up/Down: choose    OK: watch    Back: return to TV" />
      <LabelList id="list" translation="[100,190]" itemSize="[900,72]" numRows="11" vertFocusAnimationStyle="floatingFocus" />
      <Poster id="gPic" translation="[1080,190]" width="740" height="416" loadDisplayMode="scaleToFit" />
      <Label id="gTitle" translation="[1080,630]" width="740" wrap="true" maxLines="2" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="gTime" translation="[1080,730]" width="740" font="font:SmallSystemFont" color="0xC8CDD8FF" />
      <Label id="gNext" translation="[1080,780]" width="740" wrap="true" maxLines="2" font="font:SmallSystemFont" color="0x9AA3B5FF" />
      <Label id="gDesc" translation="[1080,870]" width="740" wrap="true" maxLines="3" font="font:SmallestSystemFont" color="0x9AA3B5FF" />
    </Group>

    <Group id="grid" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0e17F5" />
      <Label id="tgStation" translation="[90,40]" width="700" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="tgClock" translation="[1130,40]" width="700" horizAlign="right" font="font:SmallSystemFont" color="0x9AA3B5FF" />
      <Label id="tgTitle" translation="[90,110]" width="1740" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="tgTime" translation="[90,180]" width="1740" font="font:SmallSystemFont" color="0xC8CDD8FF" />
      <Label id="tgHint" translation="[90,1010]" width="1740" font="font:SmallestSystemFont" color="0x9AA3B5FF"
             text="Arrows: move    OK: watch that channel (or set a reminder for a later show)    Back: return to TV" />
      <TimeGrid id="tg" translation="[90,290]" numRows="7" duration="9000" channelInfoWidth="380" />
    </Group>

    <Group id="lib" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0e17F8" />
      <Rectangle id="libBar" width="12" height="70" translation="[90,45]" color="0xffcf1fFF" />
      <Label id="libHead" translation="[125,40]" width="900" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" text="On demand" />
      <Label id="libHint" translation="[960,58]" width="870" horizAlign="right" font="font:SmallestSystemFont" color="0x9AA3B5FF"
             text="OK: watch    *: favorite    Back: return to TV" />
      <Label id="libTitle" translation="[90,150]" width="1740" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="libLine" translation="[90,205]" width="1740" font="font:SmallSystemFont" color="0xC8CDD8FF" />
      <Label id="libPlot" translation="[90,250]" width="1740" wrap="true" maxLines="2" font="font:SmallestSystemFont" color="0x9AA3B5FF" />
      <RowList id="rows" translation="[90,350]" itemComponentName="LibItem" numRows="2" itemSize="[1830,310]"
               rowItemSize="[[400,225]]" rowItemSpacing="[[24,0]]" itemSpacing="[0,30]" showRowLabel="[true]"
               rowLabelOffset="[[0,10]]" rowLabelColor="0xC8CDD8FF" rowFocusAnimationStyle="floatingFocus" />
    </Group>

    <Group id="eps" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0e17FA" />
      <Label id="epShow" translation="[100,60]" width="900" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label translation="[100,125]" width="900" font="font:SmallestSystemFont" color="0x9AA3B5FF"
             text="Up/Down: choose    OK: watch    *: favorite    Back: return" />
      <LabelList id="epList" translation="[100,190]" itemSize="[900,72]" numRows="11" vertFocusAnimationStyle="floatingFocus" />
      <Poster id="epPic" translation="[1080,190]" width="740" height="416" loadDisplayMode="scaleToFit" />
      <Label id="epTitle" translation="[1080,630]" width="740" wrap="true" maxLines="2" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="epLine" translation="[1080,730]" width="740" font="font:SmallSystemFont" color="0xC8CDD8FF" />
      <Label id="epPlot" translation="[1080,790]" width="740" wrap="true" maxLines="5" font="font:SmallestSystemFont" color="0x9AA3B5FF" />
    </Group>

    <Group id="upNext" visible="false" translation="[1240,60]">
      <Rectangle width="620" height="150" color="0x0b0e17E6" />
      <Rectangle id="unBar" width="8" height="150" color="0xffcf1fFF" />
      <Label id="unHead" translation="[30,18]" width="570" font="font:SmallestBoldSystemFont" color="0xffcf1fFF" />
      <Label id="unTitle" translation="[30,52]" width="570" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="unTime" translation="[30,100]" width="570" font="font:SmallestSystemFont" color="0xC8CDD8FF" />
    </Group>

    <Group id="remBox" visible="false" translation="[1180,60]">
      <Rectangle width="680" height="210" color="0x0b0e17F0" />
      <Rectangle id="rmBar" width="8" height="210" color="0xffcf1fFF" />
      <Label id="rmHead" translation="[30,20]" width="630" font="font:SmallestBoldSystemFont" color="0xffcf1fFF" text="YOUR REMINDER - STARTING NOW" />
      <Label id="rmTitle" translation="[30,55]" width="630" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="rmWhere" translation="[30,105]" width="630" font="font:SmallSystemFont" color="0xC8CDD8FF" />
      <Label translation="[30,150]" width="630" font="font:SmallestSystemFont" color="0x9AA3B5FF" text="OK: watch it    Back: not now" />
    </Group>

    <Group id="msgBox" visible="false">
      <Rectangle width="1920" height="1080" color="0x0b0e17E0" />
      <Label id="msg" translation="[260,380]" width="1400" height="320" wrap="true" horizAlign="center" vertAlign="center"
             font="font:MediumSystemFont" color="0xFFFFFFFF" />
    </Group>

    <Timer id="bannerTimer" duration="6" />
    <Timer id="refreshTimer" duration="60" repeat="true" />
    <Timer id="seenTimer" duration="30" repeat="true" />
    <Timer id="tickTimer" duration="5" repeat="true" />
    <Timer id="remTimer" duration="20" repeat="true" />
    <Timer id="remHide" duration="120" />
    <Timer id="wxTimer" duration="600" repeat="true" />
    <Timer id="cardTimer" duration="60" />
    <Timer id="cardTick" duration="1" repeat="true" />
  </children>
</component>
